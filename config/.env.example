# Path overrides. Relative values resolve from the project root.
# The project contains its sole main dataset. Defaults below need no overrides.
# This example contains no credentials; load_settings reads environment variables.
DINEIQ_DATA_DIR=raw_data
DINEIQ_PROCESSED_DIR=processed_data
DINEIQ_ARTIFACTS_DIR=parquet_data
DINEIQ_REPORTS_DIR=reports
